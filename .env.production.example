# Production Database Credentials (used by Docker Compose and App)
DB_USER="campushub"
DB_PASSWORD="secure-database-password-change-me"
DB_NAME="campushub"

# Auth Secret for NextAuth (replace with a 32-character random secret)
# Run `openssl rand -base64 32` or generate a strong string
AUTH_SECRET=""

# Public Application URL
APP_URL="https://ch.kkdes.co.ke"

# M-Pesa Daraja Integration
MPESA_ENV="production" # or "sandbox" for staging/testing
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://ch.kkdes.co.ke/api/payments/callback"

# S3-compatible Object Storage for Uploads
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="campus-hub"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Operational Settings
ORDER_TTL_MINUTES="30"
MAX_PRINT_FILE_MB="20"
