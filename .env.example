DATABASE_URL="postgresql://campushub:campushub@localhost:5432/campushub?schema=public"
AUTH_SECRET="replace-with-a-32-character-random-secret"
APP_URL="http://localhost:3000"

# M-Pesa Daraja
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-public-domain.example/api/payments/callback"

# S3-compatible object storage for print files
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="campus-hub"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Optional operational settings
ORDER_TTL_MINUTES="30"
MAX_PRINT_FILE_MB="20"
